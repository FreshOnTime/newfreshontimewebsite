# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Public URLs
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Leave empty while API routes are served by the Next.js app.
# Set this when the backend is deployed separately, e.g. https://api.freshpick.lk
NEXT_PUBLIC_API_URL=""

# Public business contact details
NEXT_PUBLIC_SUPPORT_EMAIL="concierge@freshpick.lk"
NEXT_PUBLIC_PARTNERSHIP_EMAIL="concierge@freshpick.lk"
# International format, digits only. Example: 9477XXXXXXX
NEXT_PUBLIC_WHATSAPP_NUMBER=""

# Optional public social links. Leave blank to hide that icon.
NEXT_PUBLIC_INSTAGRAM_URL=""
NEXT_PUBLIC_FACEBOOK_URL=""
NEXT_PUBLIC_X_URL=""

# Server-side partnership notifications
B2B_INQUIRY_EMAIL="concierge@freshpick.lk"

# Authentication
JWT_SECRET="replace-with-a-long-random-secret"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="30d"
# Optional when web and API are on sibling subdomains, e.g. .freshpick.lk
AUTH_COOKIE_DOMAIN=""

# Firebase client
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Firebase Admin
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Email
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL=""

# Storage
AZURE_STORAGE_CONNECTION_STRING=""
AZURE_STORAGE_CONTAINER_NAME=""

# Analytics
NEXT_PUBLIC_GA_ID=""
