# Database
# For Supabase, DATABASE_URL may be the shared session-pool URL (port 5432).
# The application automatically uses transaction mode (6543) for serverless runtime traffic.
# Prisma CLI/migrations continue using DATABASE_URL unchanged.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
# Optional serverless Prisma pool size. Keep at 1 unless load testing shows a reason to increase it.
PRISMA_CONNECTION_LIMIT=1

# Public URLs
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Leave empty while API routes are served by the Next.js app.
# Set this when the backend is deployed separately, e.g. https://api.freshpick.lk
NEXT_PUBLIC_API_URL=""

# Public business contact details
NEXT_PUBLIC_SUPPORT_EMAIL="concierge@freshpick.lk"
NEXT_PUBLIC_PARTNERSHIP_EMAIL="concierge@freshpick.lk"
# International format, digits only. Example: 9477XXXXXXX
NEXT_PUBLIC_WHATSAPP_NUMBER=""

# Optional public social links. Leave blank to hide that icon.
NEXT_PUBLIC_INSTAGRAM_URL=""
NEXT_PUBLIC_FACEBOOK_URL=""
NEXT_PUBLIC_X_URL=""

# Server-side partnership notifications
B2B_INQUIRY_EMAIL="concierge@freshpick.lk"

# Authentication
JWT_SECRET="replace-with-a-long-random-secret"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="30d"
# Optional when web and API are on sibling subdomains, e.g. .freshpick.lk
AUTH_COOKIE_DOMAIN=""

# Firebase client
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Firebase Admin
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Email

# Supabase Storage (server-side only)
# Project URL, e.g. https://abcdefghijklmnop.supabase.co
SUPABASE_URL=""
# Use the current server secret key from Supabase Settings > API Keys.
# Legacy SUPABASE_SERVICE_ROLE_KEY is still accepted temporarily by the code.
SUPABASE_SECRET_KEY=""
# Public bucket used for product/category/blog images. Created automatically if missing.
SUPABASE_STORAGE_BUCKET="freshpick-images"

# Analytics
NEXT_PUBLIC_GA_ID=""

# Required approved delivery rate in LKR. Empty values disable order placement.
DELIVERY_FEE_LKR=
# Optional: strictly above this subtotal is free; blank disables free delivery.
DELIVERY_FREE_ABOVE_LKR=
DELIVERY_MINIMUM_LKR=0
# Comma-separated cities. Blank uses the site's published SERVICE_AREAS.
DELIVERY_AREAS=
# Transactional email and absolute links (server-only)
FRONTEND_URL=https://www.freshpick.lk
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
# Optional separate 32+ character signing key; otherwise JWT_SECRET is used.
NEWSLETTER_TOKEN_SECRET=
# Supabase Storage above is required for durable runtime image uploads on Netlify/Vercel.
